<Window x:Class="PharmaExt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PharmaExt" Height="760" Width="1180"
        MinHeight="640" MinWidth="980">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PharmaExt" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Protokoly recepturowe i etykiety Brother QL" Foreground="#555" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Wyszukiwanie">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Data od" />
                                <DatePicker SelectedDate="{Binding SearchDateFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Data do" />
                                <DatePicker SelectedDate="{Binding SearchDateTo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Pacjent / adres" />
                                <TextBox Text="{Binding SearchAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Szukaj" Command="{Binding SearchCommand}" Height="32" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding FoundPrescriptions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="50" />
                            <DataGridTextColumn Header="Nr recepty" Binding="{Binding PrescriptionNumber}" Width="130" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="220" />
                            <DataGridTextColumn Header="Adres" Binding="{Binding PatientAddress}" Width="*" />
                            <DataGridTextColumn Header="Data" Binding="{Binding PreparationDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Lekarz" Binding="{Binding DoctorName}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 Margin="0,6,0,0"
                                 IsIndeterminate="True"
                                 Foreground="#16A34A"
                                 Background="#E5E7EB"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </TabItem>

            <TabItem Header="Formularze">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="470" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ImportedFormsGrid"
                              ItemsSource="{Binding ImportedForms}"
                              SelectedItem="{Binding SelectedForm}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="ImportedFormsGrid_SelectionChanged">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="Black" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding CompositionGroupBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{Binding CompositionGroupBrush}" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="45" />
                            <DataGridCheckBoxColumn Header="Edited" Binding="{Binding IsEditedThisSession, Mode=OneWay}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Sklad" Binding="{Binding CompositionGroupLabel}" SortMemberPath="CompositionGroupSort" Width="55" />
                            <DataGridTextColumn Header="Nr recepty" Binding="{Binding PrescriptionNumber}" Width="100" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="210" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Edycja zbiorcza zaznaczonych recept" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Pole" />
                                            <ComboBox ItemsSource="{Binding BatchEditFields}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedBatchEditField}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Wartosc" />
                                            <TextBox Text="{Binding BatchEditValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Button Content="Ustaw dla zaznaczonych"
                                                    Command="{Binding ApplyBatchEditCommand}"
                                                    Height="28" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SelectedImportedForms.Count, StringFormat=Zaznaczone recepty: {0}}" Margin="0,8,0,0" />
                                    <Button Content="Kopiuj zaznaczone pola z formularza"
                                            Command="{Binding CopyCheckedFieldsCommand}"
                                            Width="250"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel DataContext="{Binding SelectedForm}">
                            <TextBlock Text="Edycja formularza" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Nr recepty" />
                                    <TextBox Text="{Binding PrescriptionNumber}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Pacjent" />
                                    <TextBox Text="{Binding PatientName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Lekarz" />
                                    <TextBox Text="{Binding DoctorName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Osoba sporzadzajaca" />
                                    <TextBox Text="{Binding PreparedByName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Data przyjecia" />
                                    <TextBox Text="{Binding AcceptanceDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Data wykonania" />
                                    <TextBox Text="{Binding PreparationDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Data sprzedazy" />
                                    <TextBox Text="{Binding SaleDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Etykieta" FontWeight="SemiBold" Margin="0,6,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelType, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="Typ" />
                                    </StackPanel>
                                    <ComboBox SelectedItem="{Binding LabelType}" ItemsSource="{Binding DataContext.LabelTypes, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelSize, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="Rozmiar" />
                                    </StackPanel>
                                    <ComboBox SelectedItem="{Binding LabelSize}" ItemsSource="{Binding DataContext.LabelSizes, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelMedicineForm, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="M.f." />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.LabelMedicineFormOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="LatinName"
                                              SelectedValue="{Binding LabelMedicineForm}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <CheckBox Content="kopiuj"
                                              IsChecked="{Binding DataContext.CopyMixBeforeUse, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Background="#DBEAFE"
                                              Margin="0,0,0,4" />
                                    <CheckBox Content="ZMIESZAĆ PRZED UŻYCIEM"
                                              IsChecked="{Binding MixBeforeUse}"
                                              FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Skladniki" FontWeight="SemiBold" Margin="0,6,0,6" />
                            <DataGrid ItemsSource="{Binding Ingredients}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      Height="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lp" Binding="{Binding Lp}" Width="40" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ilość" Binding="{Binding PrescribedQuantity}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Jedn." Binding="{Binding Unit}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ilość użyta" Binding="{Binding UsedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                                    <DataGridTextColumn Header="Seria" Binding="{Binding BatchNumber}" Width="110" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ważność" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Producent" Binding="{Binding ManufacturerSupplier}" Width="130" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Pola robocze" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualCalculations, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Obliczenia" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualCalculations}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualPreparationDescription, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Opis wykonania" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualPreparationDescription}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualQualityControl, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Kontrola koncowa" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualQualityControl}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyDosage, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Dawkowanie" />
                            </StackPanel>
                            <TextBox Text="{Binding Dosage}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualNotes, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Uwagi" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualNotes}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Ustawienia">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dane apteki" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Nazwa apteki" />
                        <TextBox Text="{Binding Settings.Pharmacy.PharmacyName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Adres apteki" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Pharmacy.PharmacyAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Firebird" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <TextBlock Text="Host" />
                        <TextBox Text="{Binding Settings.Firebird.Host, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Sciezka bazy" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Firebird.DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Uzytkownik" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Firebird.User, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Haslo" Margin="0,8,0,0" />
                        <PasswordBox x:Name="FirebirdPasswordBox" PasswordChanged="FirebirdPasswordBox_PasswordChanged" />
                        <TextBlock Text="Kodowanie" Margin="0,8,0,0" />
                        <ComboBox SelectedItem="{Binding Settings.Firebird.Charset, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding FirebirdCharsets}" />
                        <Button Content="Test polaczenia"
                                Command="{Binding TestFirebirdConnectionCommand}"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0" />

                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="Dane lokalne" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Button Content="Reset bazy lokalnej"
                                Command="{Binding ResetLocalDataCommand}"
                                Width="160"
                                Height="32"
                                HorizontalAlignment="Left" />

                        <TextBlock Text="PDF" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <TextBlock Text="Katalog zapisu" />
                        <TextBox Text="{Binding Settings.OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Width="420" HorizontalAlignment="Left" />
                        <TextBlock Text="Maks. odchył ilości użytej (%)" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.MaxUsedQuantityDeviationPercent, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zapisz" Command="{Binding SaveCommand}" Width="110" Margin="0,0,8,0" />
            <Button Content="PDF protokolu" Command="{Binding GenerateProtocolPdfCommand}" Width="130" Margin="0,0,8,0" />
            <Button Content="PDF zbiorczy" Command="{Binding GenerateBatchPdfCommand}" Width="120" Margin="0,0,8,0" />
            <Button Content="Etykiety zew." Command="{Binding GenerateExternalLabelsCommand}" Width="120" Margin="0,0,8,0" />
            <Button Content="Etykiety wew." Command="{Binding GenerateInternalLabelsCommand}" Width="120" />
        </StackPanel>
    </Grid>
</Window>
