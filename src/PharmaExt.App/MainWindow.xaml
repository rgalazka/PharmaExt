<Window x:Class="PharmaExt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PharmaExt.App.ViewModels"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="PharmaExt" Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="#E9EEF5">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding GenerateProtocolPdfCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding GenerateBatchPdfCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AcceptRecipeInstructionCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F5F9F" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#254E82" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="LineBrush" Color="#C5CEDA" />
        <SolidColorBrush x:Key="SoftLineBrush" Color="#D6DEE9" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,3,0,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D5DEEA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C3CEDB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#DDE5EF" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E7F0" />
            <Setter Property="VerticalGridLinesBrush" Value="#E0E7F0" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#F2F5F9" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#DDE7F2" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCEAFB" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C9DCF6" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
            <Setter Property="Foreground" Value="#183A5A" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:QualityDocumentTreeItem}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource SoftLineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Image Source="Assets/solcon-wordmark-transparent.png"
                           Width="118"
                           Height="28"
                           Stretch="Uniform"
                           HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PharmaExt" FontSize="26" FontWeight="SemiBold" Foreground="#102A43" />
                    <TextBlock Text="Protokoly recepturowe i etykiety Brother QL" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Wyszukiwanie" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pobierz recepty z bazy:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#183A5A"
                                   Margin="0,0,0,6" />
                        <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Data od" />
                                <DatePicker SelectedDate="{Binding SearchDateFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Data do" />
                                <DatePicker SelectedDate="{Binding SearchDateTo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Pacjent / adres" />
                                <TextBox Text="{Binding SearchAddress, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Szukaj" Command="{Binding SearchCommand}" Height="32" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                            <Button Grid.Column="4"
                                    Content="Odśwież z Firebird"
                                    Command="{Binding RefreshFirebirdRangeCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding FoundPrescriptions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="50" />
                            <DataGridTextColumn Header="Nr recepty" Binding="{Binding PrescriptionNumber}" Width="130" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="220" />
                            <DataGridTextColumn Header="Adres" Binding="{Binding PatientAddress}" Width="*" />
                            <DataGridTextColumn Header="Data" Binding="{Binding PreparationDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Lekarz" Binding="{Binding DoctorName}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 Margin="0,6,0,0"
                                 IsIndeterminate="True"
                                 Foreground="#16A34A"
                                 Background="#E5E7EB"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Formularze" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="470" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding FormsSummary}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox Content="Edytowane"
                                          IsChecked="{Binding ShowOnlyEditedForms}"
                                          Margin="0,0,12,4" />
                                <CheckBox Content="Bez IR"
                                          IsChecked="{Binding ShowOnlyFormsWithoutInstruction}"
                                          Margin="0,0,12,4" />
                                <CheckBox Content="Bez PDF"
                                          IsChecked="{Binding ShowOnlyFormsWithoutPdf}"
                                          Margin="0,0,12,4" />
                                <CheckBox Content="Podobny skład"
                                          IsChecked="{Binding ShowOnlyCompositionGroups}"
                                          Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ImportedFormsGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding ImportedForms}"
                              SelectedItem="{Binding SelectedForm}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="ImportedFormsGrid_SelectionChanged">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="Black" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding CompositionGroupBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{Binding CompositionGroupBrush}" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="45" />
                            <DataGridCheckBoxColumn Header="Edited" Binding="{Binding IsEditedThisSession, Mode=OneWay}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Skład" Binding="{Binding CompositionGroupLabel}" SortMemberPath="CompositionGroupSort" Width="55" />
                            <DataGridCheckBoxColumn Header="IR" Binding="{Binding HasInstruction, Mode=OneWay}" Width="42" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="PDF" Binding="{Binding HasGeneratedPdf, Mode=OneWay}" Width="46" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nr recepty" Binding="{Binding PrescriptionNumber}" Width="100" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,18,0">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="7"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Edycja zbiorcza zaznaczonych recept" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Pole" />
                                            <ComboBox ItemsSource="{Binding BatchEditFields}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedBatchEditField}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Wartosc" />
                                            <TextBox Text="{Binding BatchEditValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Button Content="Ustaw dla zaznaczonych"
                                                    Command="{Binding ApplyBatchEditCommand}"
                                                    Height="28" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SelectedImportedForms.Count, StringFormat=Zaznaczone recepty: {0}}" Margin="0,8,0,0" />
                                    <Button Content="Kopiuj zaznaczone pola z formularza"
                                            Command="{Binding CopyCheckedFieldsCommand}"
                                            Width="250"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel DataContext="{Binding SelectedForm}">
                            <TextBlock Text="Edycja formularza" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,12" />

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Nr recepty" />
                                    <TextBox Text="{Binding PrescriptionNumber}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Pacjent" />
                                    <TextBox Text="{Binding PatientName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Lekarz" />
                                    <TextBox Text="{Binding DoctorName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Osoba sporządzająca" />
                                    <TextBox Text="{Binding PreparedByName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Data przyjęcia" />
                                    <TextBox Text="{Binding AcceptanceDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Data wykonania" />
                                    <TextBox Text="{Binding PreparationDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Data sprzedaży" />
                                    <TextBox Text="{Binding SaleDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyMedicineExpiryDate, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="Data ważności" />
                                    </StackPanel>
                                    <DatePicker SelectedDate="{Binding MedicineExpiryDate}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Etykieta" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelType, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="Typ" />
                                    </StackPanel>
                                    <ComboBox SelectedItem="{Binding LabelType}" ItemsSource="{Binding DataContext.LabelTypes, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelSize, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="Rozmiar" />
                                    </StackPanel>
                                    <ComboBox SelectedItem="{Binding LabelSize}" ItemsSource="{Binding DataContext.LabelSizes, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding DataContext.CopyLabelMedicineForm, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                        <TextBlock Text="M.f." />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding DataContext.LabelMedicineFormOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="LatinName"
                                              SelectedValue="{Binding LabelMedicineForm}" />
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <CheckBox Content="kopiuj"
                                              IsChecked="{Binding DataContext.CopyMixBeforeUse, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Background="#DBEAFE"
                                              Margin="0,0,0,4" />
                                    <CheckBox Content="ZMIESZAĆ PRZED UŻYCIEM"
                                              IsChecked="{Binding MixBeforeUse}"
                                              FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Instrukcja wykonania leku IR" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,6" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Szukaj po składniku:"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding DataContext.RecipeInstructionSearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         Width="280"
                                         HorizontalAlignment="Left"
                                         ToolTip="Szukaj po kodzie, tytule lub składnikach instrukcji" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding DataContext.RecipeInstructions, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedItem="{Binding DataContext.SelectedRecipeInstruction, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Height="120">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DataContext.SelectedRecipeInstructionText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="120"
                                         Margin="8,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Akceptuj instrukcje"
                                        Command="{Binding DataContext.AcceptRecipeInstructionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Width="150"
                                        Height="28" />
                            </StackPanel>

                            <TextBlock Text="Składniki" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,6" />
                            <DataGrid ItemsSource="{Binding Ingredients}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      Height="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lp" Binding="{Binding Lp}" Width="40" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ilość" Binding="{Binding PrescribedQuantity}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Jedn." Binding="{Binding Unit}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ilość użyta" Binding="{Binding UsedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                                    <DataGridTextColumn Header="Seria" Binding="{Binding BatchNumber}" Width="110" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ważność" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Producent" Binding="{Binding ManufacturerSupplier}" Width="130" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Pola robocze" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualCalculations, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Obliczenia" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualCalculations}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualPreparationDescription, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Opis wykonania" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualPreparationDescription}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualQualityControl, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Kontrola końcowa" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualQualityControl}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyDosage, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Dawkowanie" />
                            </StackPanel>
                            <TextBox Text="{Binding Dosage}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding DataContext.CopyManualNotes, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DBEAFE" Margin="0,0,6,0" />
                                <TextBlock Text="Uwagi" />
                            </StackPanel>
                            <TextBox Text="{Binding ManualNotes}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Księga Jakości" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Top"
                                Content="Import dokumentów Word"
                                Command="{Binding ImportQualityDocumentsCommand}"
                                Height="32"
                                Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Szukaj instrukcji" />
                            <TextBox Text="{Binding QualityDocumentSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TreeView ItemsSource="{Binding QualityDocumentTree}"
                                  SelectedItemChanged="QualityDocumentTree_SelectedItemChanged" />
                    </DockPanel>

                    <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1" Padding="14" Margin="16,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Dokument" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <UniformGrid Grid.Row="1" Columns="2" DataContext="{Binding SelectedQualityDocument}">
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Kod" />
                                    <TextBox Text="{Binding Code}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Status" />
                                    <TextBox Text="{Binding Status}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Tytuł" />
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Wersja" />
                                    <TextBox Text="{Binding Version}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Kategoria" />
                                    <TextBox Text="{Binding CategoryName}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Aktualizacja" />
                                    <TextBox Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="Data wydania" />
                                    <DatePicker SelectedDate="{Binding IssueDate}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Data obowiązywania" />
                                    <DatePicker SelectedDate="{Binding EffectiveDate}" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Plik" Margin="0,4,0,0" />
                                <TextBox Text="{Binding SelectedQualityDocument.FilePath}" IsReadOnly="True" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="Podgląd Word" Margin="0,12,0,0" />
                            <Border Grid.Row="4" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,2,0,0">
                                <WebBrowser x:Name="QualityPreviewBrowser" />
                            </Border>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Zapisz metrykę"
                                        Command="{Binding SaveQualityDocumentMetadataCommand}"
                                        Width="120"
                                        Height="30"
                                        Margin="0,0,8,0" />
                                <Button Content="Otwórz Word"
                                        Command="{Binding OpenQualityDocumentCommand}"
                                        Width="110"
                                        Height="30"
                                        Margin="0,0,8,0" />
                                <Button Content="Nowa wersja"
                                        Command="{Binding UpdateQualityDocumentCommand}"
                                        Width="110"
                                        Height="30"
                                        Margin="0,0,8,0" />
                                <Button Content="Wygaszenie"
                                        Command="{Binding ExpireQualityDocumentCommand}"
                                        Width="110"
                                        Height="30"
                                        Margin="0,0,8,0" />
                                <Button Content="PDF"
                                        Command="{Binding GenerateQualityDocumentPdfCommand}"
                                        Width="80"
                                        Height="30" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rozliczenia" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="12"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Data sprzed. od" />
                                <DatePicker SelectedDate="{Binding SettlementDateFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Data sprzed. do" />
                                <DatePicker SelectedDate="{Binding SettlementDateTo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Pacjent / adres" />
                                <TextBox Text="{Binding SettlementAddress, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Content="Generuj raport"
                                    Command="{Binding GenerateSettlementReportCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="4"
                                    Content="PDF rozliczeń"
                                    Command="{Binding GenerateSettlementReportPdfCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom" />
                            <Button Grid.Column="5"
                                    Content="Faktura PDF"
                                    Command="{Binding GenerateSelectedSettlementInvoiceCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="6"
                                    Content="Faktury PDF"
                                    Command="{Binding GenerateAllSettlementInvoicesCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding SettlementRows}"
                              SelectedItem="{Binding SelectedSettlementRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBrush}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Drukuj FV" Binding="{Binding IsInvoiceSelected, UpdateSourceTrigger=PropertyChanged}" Width="78" />
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Data sprzed." Binding="{Binding SaleDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nr. Recepty" Binding="{Binding PrescriptionNumber}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="210" IsReadOnly="True" />
                            <DataGridTextColumn Header="Adres" Binding="{Binding PatientAddress}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nr. Faktury" Binding="{Binding InvoiceNumber}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Platnik" Binding="{Binding PayerDisplayName}" Width="190" IsReadOnly="True" />
                            <DataGridTextColumn Header="Do limitu" Binding="{Binding LimitAmount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ponad limit" Binding="{Binding OverLimitAmount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Zaplata" Binding="{Binding PaymentAmount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" BorderBrush="#D0D5DD" BorderThickness="1" Padding="10" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Suma do limitu: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SettlementLimitTotal, StringFormat={}{0:N2}}" Margin="0,0,18,0" />
                            <TextBlock Text="Ponad limit: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SettlementOverLimitTotal, StringFormat={}{0:N2}}" Margin="0,0,18,0" />
                            <TextBlock Text="Zaplata: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SettlementPaymentTotal, StringFormat={}{0:N2}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Analizy" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="12"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Data sprzed. od" />
                                <DatePicker SelectedDate="{Binding AnalysisDateFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Data sprzed. do" />
                                <DatePicker SelectedDate="{Binding AnalysisDateTo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Pacjent / adres" />
                                <TextBox Text="{Binding AnalysisAddress, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Content="Pobierz analizę"
                                    Command="{Binding GenerateAnalysisCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding AnalysisRows}"
                              SelectedItem="{Binding SelectedAnalysisRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lp." Binding="{Binding DisplayNumber}" Width="45" />
                            <DataGridTextColumn Header="Data sprzed." Binding="{Binding SaleDate, StringFormat={}{0:dd.MM.yyyy}}" Width="115" />
                            <DataGridTextColumn Header="Nr recepty" Binding="{Binding PrescriptionNumber}" Width="110" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientName}" Width="190" />
                            <DataGridTextColumn Header="Adres" Binding="{Binding PatientAddress}" Width="240" />
                            <DataGridTextColumn Header="Netto RP" Binding="{Binding TotalNet, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Brutto RP" Binding="{Binding TotalGross, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Zapłata pacj." Binding="{Binding PatientPayment, StringFormat={}{0:N2}}" Width="105" />
                            <DataGridTextColumn Header="Zysk netto" Binding="{Binding NetProfit, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Zysk - VAT" Binding="{Binding ProfitMinusVat, StringFormat={}{0:N2}}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ProfitMinusVatBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="VAT zakup" Binding="{Binding PurchaseVat, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="VAT sprzed." Binding="{Binding SalesVat, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Różnica VAT" Binding="{Binding VatDifference, StringFormat={}{0:N2}}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding VatDifferenceBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="12"
                            CornerRadius="7"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Parametry wybranej recepty" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Składniki netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.IngredientsNet, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Składniki brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.IngredientsGross, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Taxa netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.TaxaLaborumNet, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Taxa brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.TaxaLaborumGross, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Narzut netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.MarginNet, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Narzut brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.MarginGross, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="VAT sprzedaż" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.SalesVat, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="VAT zakup" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.PurchaseVat, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Zysk netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.NetProfit, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Zysk - VAT" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.ProfitMinusVat, StringFormat={}{0:N2}}"
                                               Foreground="{Binding SelectedAnalysisRow.ProfitMinusVatBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Cena netto RP" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.TotalNet, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Cena brutto RP" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.TotalGross, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Zapłata pacjenta" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.PatientPayment, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Różnica VAT" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedAnalysisRow.VatDifference, StringFormat={}{0:N2}}"
                                               Foreground="{Binding SelectedAnalysisRow.VatDifferenceBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Padding="12"
                            CornerRadius="7"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Podsumowanie okresu" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Suma recept brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisTotalGross, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Suma recept netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisTotalNet, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Suma zapłat pacjentów" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisPatientPaymentTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Same składniki brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisIngredientsGrossTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Taxa + marża brutto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisTaxAndMarginGrossTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="VAT zakup" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisPurchaseVatTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="VAT sprzedaż" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisSalesVatTotal, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Różnica VAT" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisVatDifferenceTotal, StringFormat={}{0:N2}}"
                                               Foreground="{Binding AnalysisVatDifferenceBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0" MinHeight="76">
                                    <TextBlock Text="Zysk netto" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisNetProfitTotal, StringFormat={}{0:N2}}"
                                               FontSize="36"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0" MinHeight="76">
                                    <TextBlock Text="Zysk - VAT" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AnalysisProfitMinusVatTotal, StringFormat={}{0:N2}}"
                                               Foreground="{Binding AnalysisProfitMinusVatBrush}"
                                               FontSize="36"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Magazyn" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Szukaj nazwy / BLOZ / numeru" />
                                <TextBox Text="{Binding InventorySearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Content="Tylko niezerowe ilości"
                                      IsChecked="{Binding InventoryOnlyNonZero}"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,12,7" />
                            <Button Grid.Column="2"
                                    Content="Pobierz magazyn"
                                    Command="{Binding LoadInventoryCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="3"
                                    Content="PDF magazynu"
                                    Command="{Binding GenerateInventoryPdfCommand}"
                                    Height="32"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{Binding InventoryItems}"
                              SelectedItem="{Binding SelectedInventoryItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Numer" Binding="{Binding Number}" Width="100" />
                            <DataGridTextColumn Header="Nazwa substancji" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="BLOZ 7" Binding="{Binding Bloz7}" Width="100" />
                            <DataGridTextColumn Header="Ilość ogólna" Binding="{Binding TotalQuantity, StringFormat={}{0:0.#####}}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="Dostawy wybranej pozycji"
                               FontWeight="SemiBold"
                               Margin="0,12,0,6" />

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding InventoryDeliveries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBrush}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Numer FV" Binding="{Binding InvoiceNumber}" Width="150" />
                            <DataGridTextColumn Header="Data waż." Binding="{Binding ExpiryDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Seria" Binding="{Binding BatchNumber}" Width="160" />
                            <DataGridTextColumn Header="Pozostało z dostawy" Binding="{Binding RemainingQuantity, StringFormat={}{0:0.#####}}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ustawienia" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dane apteki" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Nazwa apteki" />
                        <TextBox Text="{Binding Settings.Pharmacy.PharmacyName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Adres apteki" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Pharmacy.PharmacyAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Firebird" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <TextBlock Text="Host" />
                        <TextBox Text="{Binding Settings.Firebird.Host, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Ścieżka bazy" Margin="0,8,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FirebirdDatabasePathTextBox"
                                     Text="{Binding Settings.Firebird.DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Wybierz..."
                                    Click="BrowseFirebirdDatabase_Click"
                                    Height="24" />
                        </Grid>
                        <TextBlock Text="Użytkownik" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Firebird.User, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Hasło" Margin="0,8,0,0" />
                        <PasswordBox x:Name="FirebirdPasswordBox" PasswordChanged="FirebirdPasswordBox_PasswordChanged" />
                        <TextBlock Text="Kodowanie" Margin="0,8,0,0" />
                        <ComboBox SelectedItem="{Binding Settings.Firebird.Charset, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding FirebirdCharsets}" />
                        <Button Content="Test połączenia"
                                Command="{Binding TestFirebirdConnectionCommand}"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0" />

                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="Dane lokalne" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Button Content="Reset bazy lokalnej"
                                Command="{Binding ResetLocalDataCommand}"
                                Width="160"
                                Height="32"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="Reset lokalny z zakresu dat" Margin="0,14,0,6" />
                        <UniformGrid Columns="2" Width="260" HorizontalAlignment="Left">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Data od" />
                                <DatePicker SelectedDate="{Binding ResetLocalDateFrom}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Data do" />
                                <DatePicker SelectedDate="{Binding ResetLocalDateTo}" />
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Reset zakresu"
                                Command="{Binding ResetLocalDataRangeCommand}"
                                Width="160"
                                Height="32"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />

                        <TextBlock Text="Przenoszenie programu" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Kopia zapasowa"
                                    Command="{Binding CreateProgramBackupCommand}"
                                    Width="130"
                                    Height="32"
                                    Margin="0,0,8,0" />
                            <Button Content="Eksport danych"
                                    Command="{Binding ExportProgramDataCommand}"
                                    Width="130"
                                    Height="32"
                                    Margin="0,0,8,0" />
                            <Button Content="Import danych"
                                    Command="{Binding ImportProgramDataCommand}"
                                    Width="130"
                                    Height="32" />
                        </StackPanel>

                        <TextBlock Text="PDF" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <TextBlock Text="Katalog zapisu" />
                        <Grid Width="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryTextBox"
                                     Text="{Binding Settings.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Wybierz..."
                                    Click="BrowseOutputDirectory_Click"
                                    Height="24" />
                        </Grid>
                        <TextBlock Text="Maks. odchył ilości użytej (%)" Margin="0,8,0,0" />
                        <TextBox Text="{Binding MaxUsedQuantityDeviationPercentText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource SoftLineBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10"
                Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="{Binding AppVersion}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Zapisz"
                            Command="{Binding SaveCommand}"
                            Width="110"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0" />
                    <Button Content="PDF protokołu" Command="{Binding GenerateProtocolPdfCommand}" Width="130" Margin="0,0,8,0" />
                    <Button Content="PDF zbiorczy" Command="{Binding GenerateBatchPdfCommand}" Width="120" Margin="0,0,8,0" />
                    <Button Content="Etykiety zew." Command="{Binding GenerateExternalLabelsCommand}" Width="120" Margin="0,0,8,0" />
                    <Button Content="Etykiety wew." Command="{Binding GenerateInternalLabelsCommand}" Width="120" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
